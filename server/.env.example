# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/venue_booking

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Business & Time Settings
TIMEZONE=Asia/Kolkata
FACULTY_AUTO_APPROVE=false

# Seed User Credentials
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-me-to-a-strong-password
FACULTY_EMAIL=faculty@college.edu
FACULTY_PASSWORD=replace_with_faculty_password
STUDENT_EMAIL=student@college.edu
STUDENT_PASSWORD=replace_with_student_password
