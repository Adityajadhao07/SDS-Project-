# Copy to .env for local development. Never commit .env or paste its values into chat.
# Vercel's Neon integration provides DATABASE_URL for the project.
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Long random secret used to sign the secure login session cookie.
JWT_SERVER=replace-with-a-long-random-secret

# Comma-separated faculty registration codes.
FACULTY_CODES=replace-with-faculty-codes

# Admin credentials are configured here and are not stored in PostgreSQL.
ADMIN_USERNAMES=replace-with-admin-usernames
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional email notifications.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=replace-with-gmail-app-password

# Local server defaults to port 3000.
# PORT=3000
